{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repeater Nation Feed",
  "version": "0.1.2",
  "identifier": "com.repeaternation.feed",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Repeater Nation Feed",
        "width": 620,
        "height": 900,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#0f1318"
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["repeaternation-feed"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } }
  }
}
